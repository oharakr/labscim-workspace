# Simulation output. A single campaign point writes a 12 MB .sca and, unless the runner is
# given -V, a 1.8 GB .vec; the spectrum logs add tens of MB more. None of it is an input to
# anything -- the curves are rebuilt from the .sca by scripts/analyze_pdr.py, and the .sca is
# rebuilt by rerunning. Keeping it out means a clone stays small enough to be worth cloning.
/results/

# Python bytecode, from scripts/ being imported rather than executed.
__pycache__/
*.py[cod]

# Figures are regenerated by scripts/plot_spectrum.sh from the logs under results/. The ones
# that go in the paper live with the paper, not here.
/figures/
*.png

# ...except the screenshots the guides in docs/ embed. Without this exception the pattern
# above swallows them and the guides render with broken images on GitHub.
!/docs/images/*.png
